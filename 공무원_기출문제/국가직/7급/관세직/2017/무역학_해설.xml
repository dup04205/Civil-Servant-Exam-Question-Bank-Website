        <choice_explanation no="1" is_answer="false" judgment="[X]">
          <choice_text>shipment carriers FCA premises</choice_text>
          <commentary>㉠~㉣이 모두 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>delivery carriers FCA premises</choice_text>
          <commentary>㉡~㉣이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
