        <keyword>스티븐슨(Stephenson)</keyword>
        <keyword>관찰법 의미분석법 Q 분류법(Q sort)</keyword>
        <keyword>사회성 측정법(Sociometry)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>3</correct_answer>
