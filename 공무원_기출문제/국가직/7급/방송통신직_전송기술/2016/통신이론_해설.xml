          <commentary>70,000 bits/s이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>64,000</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>60,000</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>54,000</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
      </choice_explanations>
