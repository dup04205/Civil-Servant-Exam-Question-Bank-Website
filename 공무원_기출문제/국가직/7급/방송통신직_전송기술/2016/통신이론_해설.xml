    <question_explanation no="13" id="PRB-A50028CA4CABE0EB-Q13">
      <question_stem>신호 $50 \cos \left( 72 t + \pi \right) - 30 \sin \left( 80 \pi t + \frac{3}{4} \pi \right) + 30$을 표본화할 때, 복원을 보장하는 최대 표본화 주기[ms]는?</question_stem>
      <question_type polarity="수치/계산 도출형" category="수리·계산·자료해석형" />
      <topic_keywords>
        <keyword>신호</keyword>
        <keyword>표본화할</keyword>
        <keyword>복원</keyword>
        <keyword>보장하</keyword>
      </topic_keywords>
      <answer_info>
