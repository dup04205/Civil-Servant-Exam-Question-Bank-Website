      <topic_keywords>
        <keyword>그림과</keyword>
        <keyword>표면전하밀도</keyword>
        <keyword>각각</keyword>
        <keyword>분포하고</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>3</correct_answer>
        <correct_choice_text>점 $b$와 점 $d$에서 전속 밀도의 크기는 동일하다.</correct_choice_text>
        <answer_source>정답표 (책형교차대조: 일치)</answer_source>
      </answer_info>
