        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="X">
          <choice_text>점 $c$에서 전위는 불연속이다.</choice_text>
          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
      </choice_explanations>
