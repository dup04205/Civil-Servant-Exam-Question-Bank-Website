        <formula area="질문">d</formula>
        <formula area="질문">I_{1}</formula>
        <formula area="질문">I_{2}</formula>
        <formula area="질문">b_1 &gt; b_2</formula>
        <formula area="질문">d &gt; &gt; b_{1} , b_{2}</formula>
        <formula area="선택지①">M_{12}</formula>
        <formula area="선택지①">M_{12} PROPTO N_{1} N_{2}</formula>
        <formula area="선택지②">M_{12}</formula>
        <formula area="선택지②">M_{12} PROPTO ( b_{1} )^{2} ( b_{2} )^{2}</formula>
        <formula area="선택지③">| {\vec{F_{12}}} |</formula>
        <formula area="선택지③">| {\vec{F_{12}}} | PROPTO I_{1} I_{2}</formula>
        <formula area="선택지④">{\vec{F_{12}}}</formula>
        <formula area="선택지④">+ z</formula>
      </formulas>
      <images count="1">
