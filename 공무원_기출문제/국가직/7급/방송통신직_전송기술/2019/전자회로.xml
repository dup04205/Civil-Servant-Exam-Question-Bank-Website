      </images>
      <choices count="4">
        <choice no="1" is_answer="true">&lt;i&gt;W&lt;/i&gt;_(2 )＝ &lt;i&gt;W&lt;/i&gt;_(1), &lt;i&gt;W&lt;/i&gt;_(4 )＝ 0.5&lt;i&gt;W&lt;/i&gt;_(3)</choice>
        <choice no="2" is_answer="false">&lt;i&gt;W&lt;/i&gt;_(2 )＝ 2&lt;i&gt;W&lt;/i&gt;_(1), &lt;i&gt;W&lt;/i&gt;_(4 )＝ &lt;i&gt;W&lt;/i&gt;_(3)</choice>
