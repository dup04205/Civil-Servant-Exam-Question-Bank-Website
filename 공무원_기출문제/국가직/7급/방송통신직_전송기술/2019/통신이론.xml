        <formula area="지문">f_{Z} ( z | s_{0} ( t ) sent ) = {cases {1 / 4 , &amp; for - 3 \leq z \leq 1 # 0 , &amp; otherwise}}</formula>
        <formula area="지문">f_{Z} ( z | s_{1} ( t ) sent ) = {cases {1 / 4 , &amp; for - 1 \leq z \leq 3 # 0 , &amp; otherwise}}</formula>
