      <topic_keywords>
        <keyword>행동과학자 레빈(K. Lewin)</keyword>
        <keyword>은 인간행위(Behavior)</keyword>
        <keyword>f(P, E)</keyword>
        <keyword>P는 개체인 사람(Person)</keyword>
