    </question_explanation>
    <question_explanation no="9" id="PRB-F67F8DF47412A85E-Q9">
      <question_stem>글의 내용으로 알 수 없는 것은?</question_stem>
      <question_type polarity="부정형(옳지 않은 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>내용으</keyword>
