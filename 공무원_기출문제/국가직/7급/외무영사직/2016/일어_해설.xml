      <choice_explanations>
        <choice_explanation no="1" is_answer="false" judgment="[X]">
          <choice_text>さて</choice_text>
          <commentary>さて는 화제 전환이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>つまり</choice_text>
          <commentary>つまり이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>また</choice_text>
          <commentary>また는 첨가이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>たとえば</choice_text>
          <commentary>たとえば는 예시이다.</commentary>
        </choice_explanation>
      </choice_explanations>
      <exam_history repeat_count="2">유사·중복 출제 2회 (2016년 · 7급 공개경쟁채용시험)</exam_history>
    </question_explanation>
