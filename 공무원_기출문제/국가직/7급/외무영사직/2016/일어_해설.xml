        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>考えられる範囲の失敗</choice_text>
          <commentary>예상 범위의 실수가 아니다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>道理にははずれない失敗</choice_text>
          <commentary>의미가 다르다.</commentary>
        </choice_explanation>
      </choice_explanations>
