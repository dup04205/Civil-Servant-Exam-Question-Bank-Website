        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>Der Patient wird von dem Arzt operiert.</choice_text>
          <commentary>Der Patient wird ... operiert이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
