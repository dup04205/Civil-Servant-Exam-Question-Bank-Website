    </question_explanation>
    <question_explanation no="16" id="PRB-F030A2F4E5A96223-Q16">
      <question_stem>문법적으로 옳지 않은 문장은?</question_stem>
      <question_type polarity="부정형(옳지 않은 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>문법적</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>4</correct_answer>
        <correct_choice_text>У вас грипп, и вам нельзя попить холодную воду.</correct_choice_text>
