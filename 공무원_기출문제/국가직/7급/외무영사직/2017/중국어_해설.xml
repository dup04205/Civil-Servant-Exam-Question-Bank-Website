    <question_explanation no="7" id="PRB-3AAF3EC21B55D8F2-Q7">
      <question_stem>우리말을 중국어로 잘못 옮긴 것은?</question_stem>
      <question_type polarity="부정형(옳지 않은 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>우리말</keyword>
        <keyword>중국어</keyword>
        <keyword>잘못</keyword>
