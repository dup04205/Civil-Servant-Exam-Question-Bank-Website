        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>기숙사 방 구하기</choice_text>
          <commentary>기숙사가 아니다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>기숙사 파티 일정 공지</choice_text>
          <commentary>파티 공지가 아니다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>아파트 룸메이트 구하기</choice_text>
          <commentary>룸메이트 구하기이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
      <exam_history repeat_count="2">유사·중복 출제 2회 (2019년 · 7급 공개경쟁채용시험)</exam_history>
    </question_explanation>
