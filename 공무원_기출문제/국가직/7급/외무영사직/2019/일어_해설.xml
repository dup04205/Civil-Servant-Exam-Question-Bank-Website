    <question_explanation no="9" id="PRB-F8DFAB262F755529-Q9">
      <question_stem>밑줄 친 표현의 쓰임이 가장 적절한 것은?</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="어법·규범·어휘형" />
      <topic_keywords>
        <keyword>밑줄</keyword>
        <keyword>표현</keyword>
        <keyword>쓰임</keyword>
      </topic_keywords>
      <answer_info>
