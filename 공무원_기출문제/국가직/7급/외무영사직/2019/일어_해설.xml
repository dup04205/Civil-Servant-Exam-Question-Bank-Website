        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>ぐちゃぐちゃ がんがん そこそこ</choice_text>
          <commentary>㉡, ㉢이 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>ぶかぶか さんざん かんかん</choice_text>
