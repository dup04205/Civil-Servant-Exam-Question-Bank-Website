          <commentary>Pourquoi는 '왜'이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>Comment</choice_text>
          <commentary>Comment이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>Avec qui</choice_text>
          <commentary>Avec qui는 '누구와'이다.</commentary>
        </choice_explanation>
      </choice_explanations>
