        <choice_explanation no="1" is_answer="true" judgment="[X] (정답)">
          <choice_text>Je viens ( ) Mexique.</choice_text>
          <commentary>du가 들어가므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[O]">
          <choice_text>Je passe mes vacances ( ) Angleterre.</choice_text>
          <commentary>en이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[O]">
          <choice_text>Vous buvez du café ? － Oui, j'( ) bois.</choice_text>
          <commentary>en이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[O]">
          <choice_text>Elle fait le ménage ( ) cinquante minutes.</choice_text>
          <commentary>en이다.</commentary>
        </choice_explanation>
      </choice_explanations>
      <exam_history repeat_count="1">단독 출제 문항</exam_history>
