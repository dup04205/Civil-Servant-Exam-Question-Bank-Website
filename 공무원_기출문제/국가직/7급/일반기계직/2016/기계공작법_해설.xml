          <choice_text>ᄀ, ᄂ</choice_text>
          <commentary>ㄴ은 옳지 않다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>ㄷ, ㄹ</choice_text>
          <commentary>ㄱ도 옳다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>ㄱ, ㄷ, ㄹ</choice_text>
          <commentary>ㄱ, ㄷ, ㄹ이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>ㄴ, ㄷ, ㄹ</choice_text>
          <commentary>ㄴ은 옳지 않다.</commentary>
        </choice_explanation>
      </choice_explanations>
