          <choice_text>$3 \sqrt{5} \times 10^3$</choice_text>
          <commentary>3√5 × 10³ N은 계산 결과와 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
