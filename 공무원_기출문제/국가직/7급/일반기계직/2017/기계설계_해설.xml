        <keyword>회전운동</keyword>
        <keyword>직선운동으</keyword>
        <keyword>직선운동</keyword>
        <keyword>회전운동으</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>1</correct_answer>
        <correct_choice_text>태양기어와 유성기어</correct_choice_text>
        <answer_source>정답표 (책형교차대조: 일치)</answer_source>
