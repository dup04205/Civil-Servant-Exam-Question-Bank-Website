        <keyword>시불변 시스템에서 단위임펄스(unit impulse)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>1</correct_answer>
        <correct_choice_text>$\frac{s}{( s + 1 ) ( s + 2 )}$</correct_choice_text>
