        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>씨방 － 조세포</choice_text>
          <commentary>씨방은 2n, 조세포는 n이다.</commentary>
        </choice_explanation>
      </choice_explanations>
