        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>배유 － 극핵</choice_text>
          <commentary>배유는 3n, 극핵은 n이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>암술대 － 수술대</choice_text>
