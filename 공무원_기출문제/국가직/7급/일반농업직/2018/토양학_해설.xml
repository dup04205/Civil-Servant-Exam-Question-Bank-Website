        <choice_explanation no="3" is_answer="true" judgment="[X] (정답)">
          <choice_text>균근균에 의해 식물은 가뭄에 대한 저항성이 낮아진다.</choice_text>
          <commentary>가뭄 저항성이 높아지므로 옳지 않아 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[O]">
