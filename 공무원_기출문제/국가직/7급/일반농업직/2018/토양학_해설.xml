          <choice_text>40 Mg</choice_text>
          <commentary>40Mg이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>60 Mg</choice_text>
