    <question_explanation no="9" id="PRB-7D10A9EB8172BBF4-Q9">
      <question_stem>육종법에 대한 설명으로 옳은 것은?</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="핵심 개념·이론 이해형" />
