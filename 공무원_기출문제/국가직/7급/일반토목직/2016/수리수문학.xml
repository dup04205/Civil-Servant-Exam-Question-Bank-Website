        <formula area="지문">\bar{V} = 0 . 25 ( V_{㉢} + 2 V_{0 . 6 D} + V_{㉣} )</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="true">0.2D 0.8D 0.2D 0.8D</choice>
        <choice no="2" is_answer="false">0.2D 0.6D 0.2D 0.9D</choice>
        <choice no="3" is_answer="false">0.2D 0.8D 0.3D 0.8D</choice>
        <choice no="4" is_answer="false">0.3D 0.8D 0.3D 0.9D</choice>
      </choices>
      <answer source="정답표 (책형교차대조: 일치)" cross_check="일치">1</answer>
      <explanation_ref file="수리수문학_해설.xml" question_no="3">정답 ① · 핵심 개념·이론 이해형 (하천에서, 평균유속, 측정할, 수심)</explanation_ref>
