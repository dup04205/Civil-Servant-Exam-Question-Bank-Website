          <choice_text>2.00</choice_text>
          <commentary>2.00 m이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>2.20</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
