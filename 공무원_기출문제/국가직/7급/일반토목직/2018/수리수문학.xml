        <formula area="질문">E_r</formula>
        <formula area="지문">\sqrt{\rho_r^{- 1} E_r}</formula>
        <formula area="지문">\sqrt{\sigma_r \rho_r^{- 1} L_r^{- 1}}</formula>
        <formula area="선택지①">\sqrt{g_{r} L_r}</formula>
        <formula area="선택지①">\nu_r L_r^{- 1}</formula>
        <formula area="선택지②">\nu_r L_r^{- 1}</formula>
