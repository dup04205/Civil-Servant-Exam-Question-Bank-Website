    </question_explanation>
    <question_explanation no="2" id="PRB-F8CD1686D4AA157C-Q2">
      <question_stem>그림과 같이 중앙선에 대칭인 트러스 구조물의 E점에 수직하중 P가 작용할 때, BC부재의 부재력은? (단, 구조물의 자중은 무시한다)</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>그림과</keyword>
        <keyword>중앙선</keyword>
        <keyword>대칭인</keyword>
        <keyword>트러스</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>3</correct_answer>
        <correct_choice_text>$\frac{PL}{4 h}$</correct_choice_text>
        <answer_source>정답표 (책형교차대조: 일치)</answer_source>
      </answer_info>
