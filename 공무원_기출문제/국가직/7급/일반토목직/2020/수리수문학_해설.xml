    <question_explanation no="14" id="PRB-CCB436EB787AFB22-Q14">
      <question_stem>댐 파이핑에 대한 설명으로 옳지 않은 것은?</question_stem>
      <question_type polarity="부정형(옳지 않은 것 고르기)" category="핵심 개념·이론 이해형" />
