        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>$6 \sqrt{2} \cos ( t - 15 ^\circ )$</choice_text>
          <commentary>위상이 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>$6 \sqrt{2} \cos ( t + 15 ^\circ )$</choice_text>
