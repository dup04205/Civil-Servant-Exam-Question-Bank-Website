      <topic_keywords>
        <keyword>회로에서</keyword>
        <keyword>에서</keyword>
        <keyword>정상상태</keyword>
        <keyword>도달하였다</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>2</correct_answer>
        <correct_choice_text>$\frac{4}{3} e^{- 5 t}$</correct_choice_text>
        <answer_source>정답표 (책형교차대조: 일치)</answer_source>
      </answer_info>
