          <commentary>190.0 V는 전압변동률을 빼서 계산한 값이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>190.4</choice_text>
          <commentary>190.4 V는 계산 결과와 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>209.6</choice_text>
          <commentary>209.6 V는 계산 결과와 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>210.0</choice_text>
          <commentary>210.0 V이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
