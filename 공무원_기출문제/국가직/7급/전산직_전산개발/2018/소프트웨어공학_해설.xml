        <keyword>조직 교육 관리(organizational training)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>4</correct_answer>
        <correct_choice_text>조직 프로세스 성과 관리(organizational process performance)</correct_choice_text>
