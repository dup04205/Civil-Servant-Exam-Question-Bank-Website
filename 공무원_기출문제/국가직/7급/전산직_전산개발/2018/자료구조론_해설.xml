          <choice_text>6, 5, 3, 1, 0, 2, 4, 7, 8, 9</choice_text>
          <commentary>공식 정답에 따르면 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>6, 5, 7, 3, 8, 9, 1, 4, 0, 2</choice_text>
