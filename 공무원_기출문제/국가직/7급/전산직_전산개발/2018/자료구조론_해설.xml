          <choice_text>16</choice_text>
          <commentary>16이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>18</choice_text>
          <commentary>맞지 않다.</commentary>
        </choice_explanation>
      </choice_explanations>
