        <choice_explanation no="1" is_answer="false" judgment="X">
          <choice_text>$( i - 1 ) \times n + ( j - 1 )$</choice_text>
          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="X">
          <choice_text>$j \times ( j - 1 ) / 2 + ( i - 1 )$</choice_text>
          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="O · 정답">
          <choice_text>$i \times ( i - 1 ) / 2 + ( j - 1 )$</choice_text>
          <commentary>옳은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="X">
          <choice_text>$( j - 1 ) \times n + ( i - 1 )$</choice_text>
          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
      </choice_explanations>
