        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>15 귀무가설을 기각함</choice_text>
          <commentary>검정통계량은 15가 아니다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>15 귀무가설을 기각하지 않음</choice_text>
