        <formula area="질문">\mu</formula>
        <formula area="질문">\sigma^{2} &lt; inf</formula>
        <formula area="질문">k</formula>
        <formula area="질문">P ( | X - \mu | \geq k \sigma ) \leq \frac{1}{k^2}</formula>
        <formula area="질문">E ( X ) = 17</formula>
        <formula area="질문">E ( X^2 ) = 298</formula>
        <formula area="질문">P ( 11 &lt; X &lt; 23 )</formula>
        <formula area="선택지①">\frac{1}{4}</formula>
