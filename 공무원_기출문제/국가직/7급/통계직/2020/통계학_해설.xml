          <choice_text>18</choice_text>
          <commentary>18이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>21</choice_text>
          <commentary>21이 아니다.</commentary>
        </choice_explanation>
