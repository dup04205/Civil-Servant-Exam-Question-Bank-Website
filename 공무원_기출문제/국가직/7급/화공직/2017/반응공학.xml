      <formulas count="3">
        <formula area="지문">A REL \rightarrow {k_{1}} {} R REL \rightarrow {k_{2}} {} S</formula>
        <formula area="지문">k_{1} = 1 . 0 min^{- 1}</formula>
        <formula area="지문">k_{2} = 0 . 25 min^{- 1}</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="false">8 1.2</choice>
