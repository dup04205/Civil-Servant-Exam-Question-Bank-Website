      <topic_keywords>
        <keyword>기체의 부피 팽창률(volume expansivity)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>4</correct_answer>
        <correct_choice_text>$\frac{\kappa}{\beta}$</correct_choice_text>
        <answer_source>정답표 (책형교차대조: 일치)</answer_source>
      </answer_info>
