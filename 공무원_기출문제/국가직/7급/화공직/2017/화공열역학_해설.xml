          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="X">
          <choice_text>$- \frac{\kappa}{\beta}$</choice_text>
          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="X">
