        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>2</choice_text>
          <commentary>2는 K₁/K₂이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>50</choice_text>
          <commentary>두 반응을 더하면 K = K₁ × K₂ = 50이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>100</choice_text>
          <commentary>100은 K₁²이다.</commentary>
        </choice_explanation>
      </choice_explanations>
