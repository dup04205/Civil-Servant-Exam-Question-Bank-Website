        <formula area="질문">T_{1}</formula>
        <formula area="질문">T_{2}</formula>
        <formula area="선택지①">\frac{E}{R} = \frac{2 ( T_{2} - T_{1} ) T_{2}}{T_{1}}</formula>
        <formula area="선택지②">\frac{E}{R} = \frac{T_{1} T_{2}}{T_{2} - T_{1}} ln2</formula>
        <formula area="선택지③">\frac{E}{R} = \frac{( T_{2} - T_{1} ) T_{2}}{T_{1}} ln2</formula>
        <formula area="선택지④">\frac{E}{R} = \frac{2 T_{1} T_{2}}{T_{2} - T_{1}}</formula>
      </formulas>
      <choices count="4">
