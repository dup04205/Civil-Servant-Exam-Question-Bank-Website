        <keyword>회분식</keyword>
        <keyword>반응기에서</keyword>
        <keyword>순수한</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>3</correct_answer>
        <correct_choice_text>_($K_{c} = \frac{4 C_{A0} X_{e}^{2}}{( 1 - X_{e} )}$)</correct_choice_text>
