        <keyword>등온</keyword>
        <keyword>정압</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>1</correct_answer>
        <correct_choice_text>$C_\frac{A0}{k varepsilon_A} \ln \frac{V}{V_0}$</correct_choice_text>
        <answer_source>정답표 (책형교차대조: 일치)</answer_source>
      </answer_info>
