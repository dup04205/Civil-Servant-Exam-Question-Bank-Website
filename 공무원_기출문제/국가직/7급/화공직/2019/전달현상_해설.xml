        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>170</choice_text>
          <commentary>170℃이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
