          <choice_text>800</choice_text>
          <commentary>800K이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>800$\sqrt{2}$</choice_text>
          <commentary>맞지 않다.</commentary>
