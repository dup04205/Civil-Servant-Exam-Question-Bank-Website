        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>[CoF_(6)]^(3-)</choice_text>
          <commentary>[CoF6]³⁻는 고스핀 d⁶로 홀전자 4개이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>[NiCl_(4)]^(2-)</choice_text>
