      <topic_keywords>
        <keyword>자동촉매반응(autocatalytic reaction)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>3</correct_answer>
        <correct_choice_text>$A + R \rightarrow R + R$</correct_choice_text>
        <answer_source>정답표</answer_source>
      </answer_info>
