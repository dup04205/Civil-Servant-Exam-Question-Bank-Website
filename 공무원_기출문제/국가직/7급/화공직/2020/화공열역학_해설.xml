          <commentary>2.4bar가 아니다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>250</choice_text>
          <commentary>압력 변화량이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>251</choice_text>
          <commentary>251bar이므로 정답이다.</commentary>
        </choice_explanation>
