          <choice_text>7.8</choice_text>
          <commentary>공식 정답과 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>12.3</choice_text>
          <commentary>공식 정답과 다르다.</commentary>
        </choice_explanation>
      </choice_explanations>
