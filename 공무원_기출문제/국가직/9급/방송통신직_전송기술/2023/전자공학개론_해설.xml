          <choice_text>$\frac{1}{2 \pi \sqrt{L_{1} L_{2} C}}$</choice_text>
          <commentary>인덕턴스의 곱을 썼다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
