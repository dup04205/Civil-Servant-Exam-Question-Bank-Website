      <choice_explanations>
        <choice_explanation no="1" is_answer="true" judgment="O · 정답">
          <choice_text>$\frac{1}{2} [ M ( f - f_{c} ) + M ( f + f_{c} ) ]$</choice_text>
          <commentary>옳은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="X">
          <choice_text>$\frac{1}{2} M ( f )$</choice_text>
          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="X">
          <choice_text>$M ( f )$</choice_text>
          <commentary>옳지 않은 내용이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="X">
          <choice_text>$\frac{1}{2} [ M ( f - f_{c} ) + M ( f + f_{c} ) ]$ ＋ $\frac{1}{2} M ( f )$</choice_text>
