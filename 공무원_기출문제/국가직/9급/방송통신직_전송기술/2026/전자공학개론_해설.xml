      <topic_keywords>
        <keyword>증폭기</keyword>
        <keyword>회로</keyword>
        <keyword>전압이득</keyword>
        <keyword>비례하</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>2</correct_answer>
        <correct_choice_text>ㄱ, ㄷ</correct_choice_text>
