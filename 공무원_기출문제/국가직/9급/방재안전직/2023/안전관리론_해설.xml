    <question_explanation no="8" id="PRB-3CF5AE34F4C5D98A-Q8">
      <question_stem>레빈(K. Lewin)의 법칙을 표현하는 관계식은? (단, B는 인간의 행동, E는 심리적 환경, P는 개체, R은 휴식시간을 나타낸다)</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>레빈(K. Lewin)</keyword>
        <keyword>f(P, E)</keyword>
        <keyword>f(P, R)</keyword>
        <keyword>f(B, E)</keyword>
        <keyword>f(B, R)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>1</correct_answer>
        <correct_choice_text>B ＝ f(P, E)</correct_choice_text>
        <answer_source>정답표</answer_source>
