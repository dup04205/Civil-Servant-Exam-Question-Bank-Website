        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>환경부장관</choice_text>
          <commentary>환경부장관은 화학테러 분야를 맡는다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>질병관리청장</choice_text>
          <commentary>질병관리청장은 생물테러 분야를 맡는다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>원자력안전위원회 위원장</choice_text>
          <commentary>원자력안전위원회 위원장은 방사능테러 분야를 맡는다.</commentary>
        </choice_explanation>
      </choice_explanations>
      <exam_history repeat_count="1">단독 출제 문항</exam_history>
