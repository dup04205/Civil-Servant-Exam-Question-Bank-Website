        <formula area="선택지④">\frac{R \left{( 1 + p )^{n - m} - 1 \right}}{( 1 + p )^{n} \left{( 1 + p )^{m} - 1 \right}}</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="true">$\frac{R ( 1 + p )^{n - m}}{( 1 + p )^{n} - 1}$</choice>
        <choice no="2" is_answer="false">$\frac{R \left\{( 1 + p )^{mn} - 1 \right\}}{( 1 + p )^{m} - 1}$</choice>
        <choice no="3" is_answer="false">$\frac{R \left\{( 1 + p )^{m - n} - 1 \right\}}{( 1 + p )^{mn} \left\{( 1 + p )^{m} - 1 \right\}}$</choice>
        <choice no="4" is_answer="false">$\frac{R \left\{( 1 + p )^{n - m} - 1 \right\}}{( 1 + p )^{n} \left\{( 1 + p )^{m} - 1 \right\}}$</choice>
