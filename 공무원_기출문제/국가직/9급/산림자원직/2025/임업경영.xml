        <formula area="선택지①">\frac{R ( 1 + p )^{n - m}}{( 1 + p )^{n} - 1}</formula>
        <formula area="선택지②">\frac{R \left{( 1 + p )^{mn} - 1 \right}}{( 1 + p )^{m} - 1}</formula>
