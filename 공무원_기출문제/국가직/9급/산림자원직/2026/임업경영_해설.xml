      <question_stem>긴 회귀년에 대한 설명으로 옳은 것만을 모두 고르면?</question_stem>
      <question_type polarity="&lt;보기&gt; 조합형(옳은 것 고르기)" category="복합 보기 검증형" />
      <topic_keywords>
        <keyword>긴 회귀년</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>3</correct_answer>
        <correct_choice_text>ㄱ, ㄴ, ㄷ</correct_choice_text>
