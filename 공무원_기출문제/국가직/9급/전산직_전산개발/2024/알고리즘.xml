        <formula area="선택지②">T ( n ) = T ( \frac{n}{2} ) + c</formula>
        <formula area="선택지②">THETA ( \log_{2} n )</formula>
        <formula area="선택지③">T ( n ) = 2 T ( \frac{n}{2} ) + c</formula>
        <formula area="선택지③">THETA ( n )</formula>
        <formula area="선택지④">T ( n ) = 2 T ( \frac{n}{2} ) + n</formula>
