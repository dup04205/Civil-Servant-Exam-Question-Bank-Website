        <formula area="질문">n \times n</formula>
        <formula area="질문">A</formula>
        <formula area="질문">n \times n</formula>
        <formula area="질문">B</formula>
        <formula area="질문">C</formula>
        <formula area="질문">C</formula>
        <formula area="질문">0 \leq i</formula>
        <formula area="질문">j \leq n - 1</formula>
        <formula area="지문">C_{ij} = \sum_{k = 0}^{n - 1} A_{ik} B_{kj}</formula>
        <formula area="선택지①">THETA ( n^{2} )</formula>
        <formula area="선택지②">THETA ( n^{3} )</formula>
        <formula area="선택지③">THETA ( 2^{n} )</formula>
        <formula area="선택지④">THETA ( n logn )</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="false">$\Theta ( n^{2} )$</choice>
        <choice no="2" is_answer="true">$\Theta ( n^{3} )$</choice>
        <choice no="3" is_answer="false">$\Theta ( 2^{n} )$</choice>
        <choice no="4" is_answer="false">$\Theta ( n logn )$</choice>
      </choices>
      <answer source="정답표" cross_check="">2</answer>
      <explanation_ref file="알고리즘_해설.xml" question_no="6">[정답 2번] 긍정형(옳은/적절한 것 고르기) (수리·계산·자료해석형) | 핵심어: 를 만들 때 시간복잡도(time complexity), Theta ( n logn ) | 정답 선지: $\Theta ( n^{3} )$</explanation_ref>
