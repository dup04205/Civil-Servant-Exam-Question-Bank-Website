      <topic_keywords>
        <keyword>한 ISO 표준인 공통 기준(CC)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>4</correct_answer>
        <correct_choice_text>취약점 평가</correct_choice_text>
