      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>데몬에서</keyword>
        <keyword>사용하</keyword>
        <keyword>메시지</keyword>
