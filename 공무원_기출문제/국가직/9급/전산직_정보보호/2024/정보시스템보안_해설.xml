      <topic_keywords>
        <keyword>신뢰 플랫폼 모듈(Trusted Platform Module)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>4</correct_answer>
        <correct_choice_text>MD5 해시값 생성기</correct_choice_text>
