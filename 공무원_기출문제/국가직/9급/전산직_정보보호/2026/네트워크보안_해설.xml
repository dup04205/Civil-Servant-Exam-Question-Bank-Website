        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>-sS -A</choice_text>
          <commentary>-A는 상세 출력 옵션이 아니다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>-sT -v</choice_text>
          <commentary>-sT는 connect 스캔이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>-sT -A</choice_text>
          <commentary>-sT, -A 모두 틀렸다.</commentary>
        </choice_explanation>
      </choice_explanations>
