    <question_explanation no="7" id="PRB-D6D9CA0155F8AE62-Q7">
      <question_stem>토양의 구조에 대한 설명으로 옳지 않은 것은?</question_stem>
      <question_type polarity="부정형(옳지 않은 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>토양의 구조</keyword>
