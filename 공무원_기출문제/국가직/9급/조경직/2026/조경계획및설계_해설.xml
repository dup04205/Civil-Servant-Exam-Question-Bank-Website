      <topic_keywords>
        <keyword>우리나라</keyword>
        <keyword>유네스코</keyword>
        <keyword>세계유산에서</keyword>
        <keyword>문화유산</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>2</correct_answer>
        <correct_choice_text>제주 화산섬과 용암동굴</correct_choice_text>
