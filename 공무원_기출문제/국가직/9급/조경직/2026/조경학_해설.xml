        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>주택활용형 도시농업</choice_text>
          <commentary>주택활용형은 법정 유형이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>생태형 도시농업</choice_text>
          <commentary>생태형은 법정 유형이 아니므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>농장형ㆍ공원형 도시농업</choice_text>
          <commentary>농장형·공원형은 법정 유형이다.</commentary>
        </choice_explanation>
      </choice_explanations>
      <exam_history repeat_count="1">단독 출제 문항</exam_history>
    </question_explanation>
    <question_explanation no="7" id="PRB-4950E384D44A2016-Q7">
      <question_stem>(가), (나)에 들어갈 내용을 바르게 연결한 것은?</question_stem>
      <question_type polarity="빈칸/기호 추론형" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>내용</keyword>
