      <topic_keywords>
        <keyword>미첼(L. Mitchell)</keyword>
        <keyword>과 크럼볼츠(J. Krumboltz)</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>2</correct_answer>
        <correct_choice_text>가치와 신념</correct_choice_text>
        <answer_source>정답표</answer_source>
