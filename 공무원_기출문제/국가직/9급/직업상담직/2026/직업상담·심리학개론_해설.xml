        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>ㄱ, ㄴ, ㄷ</choice_text>
          <commentary>ㄱ, ㄴ, ㄷ이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
