        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[O]">
          <choice_text>달성 가능한 목표를 설정한다.</choice_text>
          <commentary>옳은 방법이다.</commentary>
        </choice_explanation>
      </choice_explanations>
