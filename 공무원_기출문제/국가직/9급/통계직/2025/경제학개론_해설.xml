          <commentary>175이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>200</choice_text>
          <commentary>계산값과 다르다.</commentary>
        </choice_explanation>
