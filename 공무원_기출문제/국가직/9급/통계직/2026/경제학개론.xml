        <choice no="2" is_answer="false">0.5 2 B</choice>
        <choice no="3" is_answer="false">2 0.5 B</choice>
        <choice no="4" is_answer="false">2 0.5 A</choice>
      </choices>
      <answer source="정답표" cross_check="">1</answer>
      <explanation_ref file="경제학개론_해설.xml" question_no="7">정답 ① · 핵심 개념·이론 이해형 (내용, 연결한)</explanation_ref>
