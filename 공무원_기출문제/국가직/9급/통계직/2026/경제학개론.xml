        <formula area="지문">\pi_{t} = \pi_{t}^{e} - 2 \left( u_{t} - 2 \right)</formula>
        <formula area="지문">\pi_{t}</formula>
        <formula area="지문">u_{t}</formula>
        <formula area="지문">\pi_{t}^{e}</formula>
        <formula area="지문">\pi_{t}^{e} = \pi_{t - 1}</formula>
      </formulas>
