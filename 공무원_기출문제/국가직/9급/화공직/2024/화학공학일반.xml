        <image area="지문" kind="비트맵" seq="1">이미지/PRB-845418F6DE95D614/10_지문_1.png</image>
        <image area="지문" kind="PDF크롭" seq="1">이미지/PRB-845418F6DE95D614/10_pdf_1.png</image>
      </images>
      <choices count="4">
