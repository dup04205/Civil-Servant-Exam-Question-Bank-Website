        <formula area="질문">M a</formula>
        <formula area="질문">u</formula>
        <formula area="질문">a</formula>
        <formula area="지문">M a = \frac{u}{a}</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="true">0.5</choice>
        <choice no="2" is_answer="false">1.0</choice>
