        <choice no="3" is_answer="true">12 68</choice>
        <choice no="4" is_answer="false">12 136</choice>
      </choices>
      <answer source="정답표" cross_check="">3</answer>
      <explanation_ref file="화학공학일반_해설.xml" question_no="2">정답 ③ · 수리·계산·자료해석형 (질소, 가스, 수소, 비가역적으)</explanation_ref>
    </question>
    <question no="3" id="PRB-AB9D26263B71176E-Q3" type="수치/계산 도출형" category="수리·계산·자료해석형">
