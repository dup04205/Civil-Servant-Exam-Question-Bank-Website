        <choice no="4" is_answer="false">8.6</choice>
      </choices>
      <answer source="정답표" cross_check="">3</answer>
      <explanation_ref file="화학공학일반_해설.xml" question_no="3">정답 ③ · 수리·계산·자료해석형 (통한 정상상태 열전달 플럭스(flux))</explanation_ref>
    </question>
