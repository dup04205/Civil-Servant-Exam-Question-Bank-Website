        <choice_explanation no="1" is_answer="false" judgment="[X]">
          <choice_text>$V_{C}$ ＝ 11 kN</choice_text>
          <commentary>공식 정답과 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>$V_{C}$ ＝ 12 kN</choice_text>
          <commentary>공식 정답과 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>$M_C$ ＝ 48 kN․m</choice_text>
          <commentary>공식 정답과 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>$M_C$ ＝ 54 kN․m</choice_text>
          <commentary>54 kN·m이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
