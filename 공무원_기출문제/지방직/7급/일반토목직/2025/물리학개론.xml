      <formulas count="4">
        <formula area="질문">\left | Q_{L} \right |</formula>
        <formula area="질문">DELTA t</formula>
        <formula area="지문">\left | Q_{L} \right |_</formula>
        <formula area="지문">DELTA t_</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="false">8.0 0.4</choice>
        <choice no="2" is_answer="false">7.5 0.4</choice>
        <choice no="3" is_answer="false">8.0 0.5</choice>
