          <choice_text>7,200</choice_text>
          <commentary>계산값과 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>9,600</choice_text>
          <commentary>9,600이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>22,400</choice_text>
          <commentary>계산값과 다르다.</commentary>
