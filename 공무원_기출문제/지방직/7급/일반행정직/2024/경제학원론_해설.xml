        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>60 40</choice_text>
          <commentary>계산값과 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>70 30</choice_text>
          <commentary>P = 70, Q = 30이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
