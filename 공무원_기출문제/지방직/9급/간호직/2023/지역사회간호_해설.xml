        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>프로그램 운영 간호사 수</choice_text>
          <commentary>운영 간호사 수는 구조평가 지표이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
