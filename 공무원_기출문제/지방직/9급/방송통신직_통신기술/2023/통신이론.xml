        <formula area="질문">x ( t )</formula>
        <formula area="질문">y ( t )</formula>
        <formula area="질문">H ( f )</formula>
        <formula area="질문">X ( f )</formula>
        <formula area="질문">Y ( f )</formula>
        <formula area="질문">x ( t )</formula>
        <formula area="질문">y ( t )</formula>
        <formula area="질문">X ( f ) \neq 0</formula>
        <formula area="지문">h ( t )</formula>
        <formula area="지문">\frac{Y ( f )}{X ( f )}</formula>
        <formula area="지문">x ( t ) = e^{j2 \pi ft}</formula>
        <formula area="지문">\frac{y ( t )}{x ( t )}</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="false">ㄱ</choice>
        <choice no="2" is_answer="false">ㄱ, ㄴ</choice>
        <choice no="3" is_answer="false">ㄴ, ㄷ</choice>
        <choice no="4" is_answer="true">ㄱ, ㄴ, ㄷ</choice>
      </choices>
      <answer source="정답표" cross_check="">4</answer>
      <explanation_ref file="통신이론_해설.xml" question_no="16">정답 ④ · 수리·계산·자료해석형 (h ( t ), x ( t ), y ( t ), H ( f ), X ( f )) — 보기 판정: ㄱ(O), ㄴ(O), ㄷ(O)</explanation_ref>
    </question>
