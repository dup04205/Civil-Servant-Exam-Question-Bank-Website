    <question_explanation no="7" id="PRB-3370F534EB77AC72-Q7">
      <question_stem>전기회로에 대한 설명으로 옳은 것은?</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="핵심 개념·이론 이해형" />
