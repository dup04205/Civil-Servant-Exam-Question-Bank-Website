        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>A C B</choice_text>
          <commentary>A, C, B이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>B A C</choice_text>
          <commentary>순서가 맞지 않는다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>B C A</choice_text>
          <commentary>순서가 맞지 않는다.</commentary>
        </choice_explanation>
      </choice_explanations>
