    <question_explanation no="1" id="PRB-258838AC898F06D8-Q1">
      <question_stem>｢재난 및 안전관리 기본법｣상 긴급구조기관에 해당하지 않는 것은?</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="법령·조문 적용형" />
      <topic_keywords>
        <keyword>「재난 및 안전관리 기본법」</keyword>
      </topic_keywords>
      <law_references source="법제처 국가법령정보센터">
        <law name="재난 및 안전관리 기본법" law_id="009640" mst="282883" effective_date="2026-07-22" type="법률">자연재난·사회재난 정의(제3조), 안전관리위원회·중앙재난안전대책본부(제14조), 재난사태 선포(제36조)·특별재난지역 선포(제60조) 및 국가안전관리기본계획 조문 검증</law>
      </law_references>
      <answer_info>
        <correct_answer>2</correct_answer>
        <correct_choice_text>경찰청</correct_choice_text>
        <answer_source>정답표</answer_source>
      </answer_info>
      <overall_commentary>출제 영역: 재난관리론 · 긴급구조기관
정답은 ②이다. ｢재난 및 안전관리 기본법｣상 긴급구조기관은 소방청·소방본부·소방서이고, 해양에서는 해양경찰청·지방해양경찰청·해양경찰서이다. 경찰청은 긴급구조지원기관이다.</overall_commentary>
      <choice_explanations>
        <choice_explanation no="1" is_answer="false" judgment="[X]">
          <choice_text>소방청</choice_text>
          <commentary>소방청은 긴급구조기관이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>경찰청</choice_text>
          <commentary>경찰청은 긴급구조기관이 아니므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>소방서</choice_text>
          <commentary>소방서는 긴급구조기관이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>소방본부</choice_text>
          <commentary>소방본부는 긴급구조기관이다.</commentary>
        </choice_explanation>
      </choice_explanations>
