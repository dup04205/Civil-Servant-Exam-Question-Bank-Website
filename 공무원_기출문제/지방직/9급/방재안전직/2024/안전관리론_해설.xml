          <commentary>1은 계산 결과와 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>10</choice_text>
          <commentary>강도율 10이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>100</choice_text>
          <commentary>100은 계산 결과와 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>1,000</choice_text>
          <commentary>1,000은 계산 결과와 다르다.</commentary>
        </choice_explanation>
      </choice_explanations>
