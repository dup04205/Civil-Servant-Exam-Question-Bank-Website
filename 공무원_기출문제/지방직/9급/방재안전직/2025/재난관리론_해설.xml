    <question_explanation no="2" id="PRB-A8A1F2DC9059BAD2-Q2">
      <question_stem>｢재난 및 안전관리 기본법｣상 국가 및 지방자치단체가 행하는 재난 및 안전관리 업무를 총괄ㆍ조정하는 자는?</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="법령·조문 적용형" />
      <topic_keywords>
        <keyword>「재난 및 안전관리 기본법」</keyword>
      </topic_keywords>
      <law_references source="법제처 국가법령정보센터">
        <law name="재난 및 안전관리 기본법" law_id="009640" mst="282883" effective_date="2026-07-22" type="법률">자연재난·사회재난 정의(제3조), 안전관리위원회·중앙재난안전대책본부(제14조), 재난사태 선포(제36조)·특별재난지역 선포(제60조) 및 국가안전관리기본계획 조문 검증</law>
      </law_references>
      <answer_info>
        <correct_answer>3</correct_answer>
        <correct_choice_text>행정안전부장관</correct_choice_text>
        <answer_source>정답가안</answer_source>
      </answer_info>
      <overall_commentary>출제 영역: 재난관리론 · 재난 및 안전관리 업무의 총괄·조정
정답은 ③이다. ｢재난 및 안전관리 기본법｣상 행정안전부장관은 국가 및 지방자치단체가 행하는 재난 및 안전관리 업무를 총괄·조정한다.</overall_commentary>
      <choice_explanations>
        <choice_explanation no="1" is_answer="false" judgment="[X]">
          <choice_text>대통령</choice_text>
          <commentary>대통령은 총괄·조정 주체로 규정되지 않는다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>국무총리</choice_text>
          <commentary>국무총리는 중앙안전관리위원회 위원장이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>행정안전부장관</choice_text>
          <commentary>행정안전부장관이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>중앙안전관리위원회 위원장</choice_text>
          <commentary>중앙안전관리위원회 위원장은 국무총리이다.</commentary>
        </choice_explanation>
      </choice_explanations>
      <exam_history repeat_count="2">유사·중복 출제 2회 (2025년 · 제1회 지방직공무원 시험 | 제1회 지방직공무원 시험(시도교육청))</exam_history>
