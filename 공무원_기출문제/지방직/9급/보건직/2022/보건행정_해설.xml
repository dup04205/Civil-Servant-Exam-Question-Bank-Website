      <topic_keywords>
        <keyword>내용</keyword>
        <keyword>포함하</keyword>
        <keyword>진료비</keyword>
        <keyword>지불방법</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>4</correct_answer>
        <correct_choice_text>행위별수가제</correct_choice_text>
