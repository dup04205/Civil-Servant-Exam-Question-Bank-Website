        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>건강검진</choice_text>
          <commentary>현물급여이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>장애인보장구 급여</choice_text>
          <commentary>현금급여이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>본인부담상한액 초과금</choice_text>
