        </choice_explanation>
        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>폴리오</choice_text>
          <commentary>바이러스성 질병이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>콜레라</choice_text>
          <commentary>콜레라균에 의한 세균성 질병이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>장티푸스</choice_text>
          <commentary>장티푸스균에 의한 세균성 질병이다.</commentary>
        </choice_explanation>
      </choice_explanations>
