      <choice_explanations>
        <choice_explanation no="1" is_answer="false" judgment="[X]">
          <choice_text>팜플렛</choice_text>
          <commentary>팜플렛은 단행본 기술 대상이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>점자자료</choice_text>
          <commentary>점자자료는 해당하지 않으므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>별쇄본</choice_text>
          <commentary>별쇄본은 단행본 기술 대상이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>도서가 주된 구성요소인 복합매체자료</choice_text>
          <commentary>도서 중심 복합매체자료는 단행본 기술 대상이다.</commentary>
        </choice_explanation>
      </choice_explanations>
