          <choice_text>10,000</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>15,000</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>20,000</choice_text>
          <commentary>20,000 m³이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>25,000</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
      </choice_explanations>
