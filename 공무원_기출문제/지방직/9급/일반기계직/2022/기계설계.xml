        <formula area="질문">\nu</formula>
        <formula area="선택지①">\sigma_\frac{Y}{root} {1 + \nu}</formula>
        <formula area="선택지②">\sigma_\frac{Y}{root} {2}</formula>
        <formula area="선택지③">\sigma_\frac{Y}{root3}</formula>
        <formula area="선택지④">\sigma_\frac{Y}{2 root ( 1 + \nu )}</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="false">$\sigma_\frac{Y}{\sqrt{}} {1 + \nu}$</choice>
        <choice no="2" is_answer="false">$\sigma_\frac{Y}{\sqrt{}} {2}$</choice>
        <choice no="3" is_answer="true">$\sigma_\frac{Y}{root3}$</choice>
        <choice no="4" is_answer="false">$\sigma_\frac{Y}{2 \sqrt{(} 1 + \nu )}$</choice>
      </choices>
      <answer source="정답표" cross_check="">3</answer>
