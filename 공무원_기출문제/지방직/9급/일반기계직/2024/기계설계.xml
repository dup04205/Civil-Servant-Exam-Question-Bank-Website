        <formula area="질문">\omega_{1}</formula>
        <formula area="질문">\omega_{2}</formula>
        <formula area="질문">\omega_{1} \cos \alpha \sim \frac{\omega_{1}}{\cos \alpha}</formula>
        <formula area="질문">T_{1}</formula>
        <formula area="질문">T_{2}</formula>
        <formula area="선택지①">T_{1} \sin \alpha</formula>
        <formula area="선택지②">\frac{T_{1}}{\sin \alpha}</formula>
        <formula area="선택지③">T_{1} \cos \alpha</formula>
        <formula area="선택지④">\frac{T_{1}}{\cos \alpha}</formula>
      </formulas>
