    <question_explanation no="8" id="PRB-408E0BDCFCB4B7B3-Q8">
      <question_stem>수명시간이 80,000 h인 볼 베어링에서 베어링 하중(동 등가하중)이 2배가 되면 수명시간[h]은? (단, 회전속도와 기본 동정격하중은 일정하다)</question_stem>
      <question_type polarity="수치/계산 도출형" category="수리·계산·자료해석형" />
      <topic_keywords>
        <keyword>수명시간</keyword>
        <keyword>베어링에서</keyword>
        <keyword>베어링</keyword>
        <keyword>하중</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>1</correct_answer>
