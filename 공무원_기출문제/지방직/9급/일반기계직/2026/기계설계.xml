        <formula area="선택지③">\frac{\tan ( \alpha )}{\tan ( \rho - \alpha )}</formula>
        <formula area="선택지④">\frac{\tan ( \rho - \alpha )}{\tan ( \alpha )}</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="false">$\frac{\tan ( \alpha )}{\tan ( \rho + \alpha )}$</choice>
