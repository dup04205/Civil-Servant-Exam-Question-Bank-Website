    <question_explanation no="5" id="PRB-777D8E6F49D7E226-Q5">
      <question_stem>농업경영 면에서 작부체계의 중요성에 대한 설명으로 옳지 않은 것은?</question_stem>
      <question_type polarity="부정형(옳지 않은 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>농업경영 면에서 작부체계의 중요성</keyword>
      </topic_keywords>
      <answer_info>
