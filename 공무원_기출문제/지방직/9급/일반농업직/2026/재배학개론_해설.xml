    <question_explanation no="8" id="PRB-777D8E6F49D7E226-Q8">
      <question_stem>채종재배 시 주의해야 할 사항이 아닌 것은?</question_stem>
      <question_type polarity="부정형(옳지 않은 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>채종재배</keyword>
        <keyword>주의해야</keyword>
        <keyword>사항</keyword>
        <keyword>아닌</keyword>
      </topic_keywords>
      <answer_info>
