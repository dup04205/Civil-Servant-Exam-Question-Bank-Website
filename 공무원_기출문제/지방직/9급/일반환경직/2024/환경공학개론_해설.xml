        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>1 mm/s^(2)</choice_text>
          <commentary>0.1 Gal이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>1 dm/s^(2)</choice_text>
          <commentary>10 Gal이다.</commentary>
