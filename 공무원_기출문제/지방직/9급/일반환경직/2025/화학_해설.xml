          <commentary>비율이 1 : 4 : 1이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>C_(2)H_(6)O_(2)</choice_text>
          <commentary>비율이 1 : 3 : 1이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>C_(3)H_(8)O</choice_text>
          <commentary>비율이 3 : 8 : 1이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[O] (정답)">
          <choice_text>C_(6)H_(12)O_(6)</choice_text>
          <commentary>C₆H₁₂O₆이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
