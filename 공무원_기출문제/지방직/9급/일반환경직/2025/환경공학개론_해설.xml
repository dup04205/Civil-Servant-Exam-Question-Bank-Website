    <question_explanation no="8" id="PRB-2551232F5DCC3D07-Q8">
      <question_stem>폐수처리 공정 중 물리적 처리는?</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>폐수처리</keyword>
        <keyword>공정</keyword>
        <keyword>물리적</keyword>
        <keyword>처리</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>1</correct_answer>
        <correct_choice_text>스크린</correct_choice_text>
        <answer_source>정답가안</answer_source>
