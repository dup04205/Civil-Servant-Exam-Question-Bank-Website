          <commentary>O₂ 3 mol이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>128</choice_text>
          <commentary>128 g이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>160</choice_text>
