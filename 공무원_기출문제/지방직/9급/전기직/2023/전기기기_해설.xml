          <choice_text>0 비례</choice_text>
          <commentary>위상과 비례 관계가 모두 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>0 반비례</choice_text>
          <commentary>위상차가 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
