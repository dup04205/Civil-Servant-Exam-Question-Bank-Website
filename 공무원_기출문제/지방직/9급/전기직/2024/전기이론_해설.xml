          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="true" judgment="[O] (정답)">
          <choice_text>6 × 10^(－3)</choice_text>
          <commentary>6 × 10^-3 Wb이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[X]">
          <choice_text>3 × 10^(－4)</choice_text>
          <commentary>계산이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>6 × 10^(－4)</choice_text>
