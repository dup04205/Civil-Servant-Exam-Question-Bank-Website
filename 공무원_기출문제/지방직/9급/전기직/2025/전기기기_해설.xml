        <choice_explanation no="2" is_answer="false" judgment="[X]">
          <choice_text>200 2배</choice_text>
          <commentary>2차 전압과 자속이 틀렸다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>400 1배</choice_text>
          <commentary>400 V, 1배이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>400 2배</choice_text>
          <commentary>자속은 변하지 않는다.</commentary>
        </choice_explanation>
      </choice_explanations>
