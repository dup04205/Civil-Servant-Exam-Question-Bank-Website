    <question_explanation no="8" id="PRB-58446DEC2C6CB625-Q8">
      <question_stem>권선형 유도전동기에만 사용되는 속도 제어 방법은?</question_stem>
      <question_type polarity="긍정형(옳은/적절한 것 고르기)" category="핵심 개념·이론 이해형" />
      <topic_keywords>
        <keyword>권선형</keyword>
        <keyword>유도전동기에만</keyword>
        <keyword>사용되</keyword>
        <keyword>속도</keyword>
      </topic_keywords>
      <answer_info>
        <correct_answer>4</correct_answer>
        <correct_choice_text>2차여자 제어 방식</correct_choice_text>
        <answer_source>정답표</answer_source>
