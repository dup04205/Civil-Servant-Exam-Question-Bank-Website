          <commentary>4%는 계산 결과와 다르다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="true" judgment="[O] (정답)">
          <choice_text>5</choice_text>
          <commentary>5%이므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[X]">
          <choice_text>6</choice_text>
