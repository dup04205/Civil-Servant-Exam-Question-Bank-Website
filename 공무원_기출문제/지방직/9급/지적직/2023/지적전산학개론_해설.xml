        <choice_explanation no="1" is_answer="true" judgment="[X] (정답)">
          <choice_text>필지경계(Parcel Boundary)</choice_text>
          <commentary>필지경계는 추출할 수 없으므로 정답이다.</commentary>
        </choice_explanation>
        <choice_explanation no="2" is_answer="false" judgment="[O]">
          <choice_text>표고(Elevation)</choice_text>
          <commentary>표고는 DEM의 기본 정보이다.</commentary>
        </choice_explanation>
        <choice_explanation no="3" is_answer="false" judgment="[O]">
          <choice_text>경사도(Slope)</choice_text>
          <commentary>경사도는 DEM에서 계산한다.</commentary>
        </choice_explanation>
        <choice_explanation no="4" is_answer="false" judgment="[O]">
          <choice_text>경사방향(Aspect)</choice_text>
          <commentary>경사방향은 DEM에서 계산한다.</commentary>
        </choice_explanation>
      </choice_explanations>
