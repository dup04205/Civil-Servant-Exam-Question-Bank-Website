        </choice_explanation>
        <choice_explanation no="4" is_answer="true" judgment="[X] (정답)">
          <choice_text>경계 및 현황 추출</choice_text>
          <commentary>경계 및 현황 추출은 영상 제작 이후 작업이므로 정답이다.</commentary>
        </choice_explanation>
      </choice_explanations>
