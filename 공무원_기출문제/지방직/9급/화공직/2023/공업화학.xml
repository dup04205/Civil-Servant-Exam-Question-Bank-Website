        <formula area="질문">H_{2} ( it g )</formula>
        <formula area="질문">CH_{4} ( it g )</formula>
        <formula area="질문">H_{2} ( it g )</formula>
        <formula area="질문">{{V_\frac{CH_{4}}{{V_{H_{2}}^{}}}}}</formula>
        <formula area="질문">C</formula>
        <formula area="질문">H</formula>
        <formula area="선택지①">\frac{1}{3}</formula>
        <formula area="선택지②">\frac{3}{8}</formula>
        <formula area="선택지③">\frac{8}{3}</formula>
        <formula area="선택지④">3</formula>
      </formulas>
      <choices count="4">
        <choice no="1" is_answer="true">$\frac{1}{3}$</choice>
